# CoinGecko demo API key (get one free at https://www.coingecko.com/en/developers/dashboard)
# Used only by the CoinGecko FX provider as last-resort fallback.
# DATA__FX__COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxxxxxx

# CoinGecko quota overrides (defaults: 100/min, 10000/month, warn at 9500)
# DATA__FX__COINGECKO_MAX_PER_MINUTE=100
# DATA__FX__COINGECKO_MAX_PER_MONTH=10000
# DATA__FX__COINGECKO_WARN_THRESHOLD=9500
